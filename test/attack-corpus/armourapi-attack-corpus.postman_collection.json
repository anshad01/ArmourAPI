    {
      "name": "5. Broken Function Level Authorization - BFLA (API5:2023)",
      "item": [
        {
          "name": "Any authenticated role can hit inventory update (no role check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"request passes through (NOT MITIGATED: no RBAC route enforcement built - any valid token passes, regardless of role)\", function () {",
                  "  pm.expect(pm.response.code).to.not.eql(403);",
                  "});",
                  "// KNOWN GAP: token-guard.js verifies a valid, non-revoked token but does not",
                  "// check claims.role against the route. request.armourapiUser.role is populated",
                  "// and available for a future @RequireRoles('Manager')-style layer, but that",
                  "// layer was not built (out of FR6's scope, which covers token/session",
                  "// mechanics, not authorization policy). Do not report this class as mitigated."
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/inventory/99",
            "body": {
              "mode": "raw",
              "raw": "{\"quantity\":5,\"reason\":\"correction\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "6. SSRF (API7:2023)",
      "item": [
        {
          "name": "Internal metadata IP in a request field (generic WAF pattern check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"code field pattern rejected by schema (alphanumeric only)\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "// NOTE: this only proves the discount code's regex rejects URL-shaped input,",
                  "// not that ArmourAPI performs SSRF egress filtering. The doc's SSRF scenario",
                  "// (a webhook/receipt-delivery URL field) has no corresponding endpoint in the",
                  "// current build - Section 3's endpoint table doesn't define one. This test",
                  "// class is NOT meaningfully exercised yet; flagged as untested, not mitigated."
                ]
              }
            }
