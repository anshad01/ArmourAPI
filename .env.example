PORT=8080
LOG_LEVEL=info
# FR7: set to also write structured logs to a file, e.g. logs/armourapi.log,
# so Filebeat (see docker-compose.yml) can tail and ship them to Elasticsearch.
LOG_FILE=

# Protected targets (path-based routing)
JUICE_SHOP_URL=http://localhost:3000
DVGA_URL=http://localhost:5013
ANDROGOAT_URL=http://localhost:5000

REDIS_URL=redis://localhost:6379

# FR4: rate limiting (falls back to in-memory, single-instance only, if Redis is unreachable)
RATE_LIMIT_GLOBAL_POINTS=300
RATE_LIMIT_GLOBAL_DURATION=60
RATE_LIMIT_LOGIN_FAIL_POINTS=5
RATE_LIMIT_LOGIN_FAIL_DURATION=60

# FR9: passthrough | coraza | nginx-modsecurity
WAF_ENGINE=coraza
# Number of Coraza WASM worker threads (concurrency headroom vs. RAM budget -
# NFR2 targets <256MB total; each worker holds its own compiled CRS/WASM
# instance). Default: min(4, CPU cores).
WAF_POOL_SIZE=
# Only used when WAF_ENGINE=nginx-modsecurity - see docker-compose.yml's
# nginx-modsecurity service (maps container port 8080 to host 8081).
NGINX_MODSECURITY_URL=http://localhost:8081

JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
