{
  "title": "ArmourAPI Security Overview",
  "uid": "armourapi-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate: allow vs block",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(armourapi_requests_total[1m])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Blocked requests by category",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(armourapi_blocked_total[5m])) by (category)",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Total blocked, by category (FR10 dashboard view)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (armourapi_blocked_total)",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request latency added by ArmourAPI (p50/p95/p99)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(armourapi_request_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(armourapi_request_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(armourapi_request_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU (% of this laptop's total capacity)",
      "description": "Client-requested: CPU relative to host capacity, not per-core - target is under 5%.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(process_cpu_user_seconds_total[1m]) / system_cpu_count) * 100"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Process RAM (MB)",
      "description": "Raw figure against the doc's <256MB target. See the host-capacity-% panel below for the client-requested relative view.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 256 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes / 1024 / 1024"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "RAM (% of this laptop's total capacity)",
      "description": "Client-requested: RAM relative to host capacity - \"if the app is installed on our individual laptops, the dashboard should display CPU & RAM usage relative to our storage capacity.\"",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(process_resident_memory_bytes / system_total_memory_bytes) * 100"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total requests",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(armourapi_requests_total)"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Total blocked",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(armourapi_blocked_total)"
        }
      ]
    }
  ]
}
